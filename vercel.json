{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/api/index\\.php",
      "dest": "/api/index.php"
    },
    {
      "src": "/",
      "dest": "/api/index.php?path=/index.php"
    },
    {
      "src": "/(.+\\.php)",
      "dest": "/api/index.php?path=/$1"
    }
  ]
}